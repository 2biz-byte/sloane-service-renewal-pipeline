{
  "schemaVersion": 2,
  "resourceKey": "pipeline.sloane.service-renewal-workflow",
  "storage": {
    "listRef": {
      "kind": "list",
      "resourceKey": "list.sloane.service-renewals"
    }
  },
  "pipeline": {
    "name": "service-renewal-workflow",
    "description": "Household service renewal workflow: intake -> contract_read -> usage_summarized -> draft_ready.",
    "columns": [
      { "id": "case_id", "key": "case_id", "label": "Case ID", "type": "text", "order": 0 },
      { "id": "service_name", "key": "service_name", "label": "Service Name", "type": "text", "order": 1 },
      { "id": "provider", "key": "provider", "label": "Provider", "type": "text", "order": 2 },
      { "id": "plan", "key": "plan", "label": "Plan", "type": "text", "order": 3 },
      { "id": "current_monthly_usd", "key": "current_monthly_usd", "label": "Current Monthly USD", "type": "number", "order": 4 },
      { "id": "proposed_monthly_usd", "key": "proposed_monthly_usd", "label": "Proposed Monthly USD", "type": "number", "order": 5 },
      { "id": "hike_pct", "key": "hike_pct", "label": "Hike %", "type": "number", "order": 6 },
      { "id": "contract_end", "key": "contract_end", "label": "Contract End", "type": "date", "order": 7 },
      { "id": "promo_note", "key": "promo_note", "label": "Promo Note", "type": "text", "order": 8 },
      { "id": "competitor_offer_usd", "key": "competitor_offer_usd", "label": "Competitor Offer USD", "type": "number", "order": 9 },
      { "id": "status", "key": "status", "label": "Status", "type": "text", "order": 10 },
      { "id": "usage_history", "key": "usage_history", "label": "Usage History", "type": "text", "order": 11 }
    ],
    "stages": [
      {
        "id": "intake",
        "name": "Intake",
        "type": "initial",
        "description": "Renewal case enters the workflow.",
        "triggerKind": "manual",
        "order": 0
      },
      {
        "id": "contract_read",
        "name": "Contract Read",
        "type": "intermediate",
        "description": "Renewal notice and contract terms read (Gmail).",
        "triggerKind": "manual",
        "order": 1
      },
      {
        "id": "usage_summarized",
        "name": "Usage Summarized",
        "type": "intermediate",
        "description": "Monthly spend and usage summarized (Sheets).",
        "triggerKind": "manual",
        "order": 2
      },
      {
        "id": "draft_ready",
        "name": "Draft Ready",
        "type": "terminal",
        "description": "Negotiation email draft ready (Gmail draft, never sent).",
        "triggerKind": "manual",
        "order": 3
      }
    ],
    "transitions": [
      {
        "id": "to_contract_read",
        "name": "Contract reviewed",
        "fromStageId": "intake",
        "toStageId": "contract_read",
        "trigger": "manual",
        "fieldMappings": [],
        "success": {
          "advanceToStageId": "contract_read",
          "persistMode": "shared_patch",
          "fieldMappings": [
            { "targetField": "status", "sourcePath": "status" }
          ]
        }
      },
      {
        "id": "to_usage_summarized",
        "name": "Usage summarized",
        "fromStageId": "contract_read",
        "toStageId": "usage_summarized",
        "trigger": "manual",
        "fieldMappings": [],
        "success": {
          "advanceToStageId": "usage_summarized",
          "persistMode": "shared_patch",
          "fieldMappings": [
            { "targetField": "status", "sourcePath": "status" }
          ]
        }
      },
      {
        "id": "to_draft_ready",
        "name": "Draft ready",
        "fromStageId": "usage_summarized",
        "toStageId": "draft_ready",
        "trigger": "manual",
        "fieldMappings": [],
        "success": {
          "advanceToStageId": "draft_ready",
          "persistMode": "shared_patch",
          "fieldMappings": [
            { "targetField": "status", "sourcePath": "status" }
          ]
        }
      }
    ]
  },
  "commitMessage": "Convert service-renewal pipeline to schema v2 portable"
}
